{
  "name": "translate-shield",
  "version": "0.1.0",
  "description": "Keeps React and Next.js apps correct when a browser translator rewrites the DOM: no crash, no frozen values, and no flash of the original language.",
  "keywords": [
    "google-translate",
    "browser-translation",
    "react",
    "nextjs",
    "removechild",
    "notfounderror",
    "mutationobserver",
    "i18n",
    "dom",
    "accessibility"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@types/react": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "bunchee",
    "dev": "npm run dev -w tests/app",
    "recorder": "vite --port 5200 --strictPort research/recorder",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "summarise": "node scripts/summarise-fingerprints.mjs",
    "verify": "npm run typecheck && npm run build && npx publint --strict && npx attw --pack .",
    "prepublishOnly": "npm run build",
    "postbuild": "node scripts/assert-directives.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "bunchee": "^7.0.1",
    "esbuild": "^0.28.2",
    "publint": "^0.3.0",
    "react": "^19.0.0",
    "translation-resilience": "^0.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "workspaces": [
    "tests/app"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Davlatbek Aliev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alievdavlat/translate-shield.git"
  },
  "bugs": {
    "url": "https://github.com/alievdavlat/translate-shield/issues"
  },
  "homepage": "https://github.com/alievdavlat/translate-shield#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  }
}
